rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True when the signed-in user owns this shop.
    function isShopOwner(shopId) {
      return signedIn()
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
    }

    // True when the signed-in user is an ACTIVE munshi (staff) of this shop.
    // Disabling a munshi (users/{uid}.isActive = false) cuts access immediately.
    function isStaffOf(shopId) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'staff'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.shopId == shopId
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

    function isMember(shopId) {
      return isShopOwner(shopId) || isStaffOf(shopId);
    }

    // users/{uid}: one document per account (owner or munshi)
    match /users/{uid} {
      // Everyone reads their own profile. The owner can also read the profiles
      // of their munshis (query: where shopId == X).
      allow read: if signedIn()
        && (request.auth.uid == uid || isShopOwner(resource.data.shopId));

      // Owner registers themselves.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid','ownerName','shopName','phone','email','role','shopId','isActive','createdAt'])
        && request.resource.data.keys().hasAll(
             ['uid','ownerName','shopName','email','role','shopId','isActive','createdAt'])
        && request.resource.data.uid == uid
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20))
        && request.resource.data.role == 'owner'
        && request.resource.data.isActive == true
        && request.resource.data.shopId is string
        && getAfter(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.ownerUid == uid;

      // Owner creates a munshi profile for ANOTHER uid (the auth account was
      // just created by the app). role is forced to 'staff'.
      allow create: if signedIn()
        && request.auth.uid != uid
        && request.resource.data.keys().hasOnly(
             ['uid','ownerName','shopName','phone','email','role','shopId','isActive','createdAt'])
        && request.resource.data.keys().hasAll(
             ['uid','ownerName','shopName','email','role','shopId','isActive','createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.role == 'staff'
        && request.resource.data.isActive == true
        && request.resource.data.shopId is string
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() > 0
        && request.resource.data.ownerName.size() <= 60
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20))
        && isShopOwner(request.resource.data.shopId);

      // 1) A user edits their own name / phone only. role / isActive / shopId can never change here.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerName','phone'])
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20));

      // 2) The owner can switch a munshi on / off (isActive) and nothing else.
      allow update: if signedIn()
        && request.auth.uid != uid
        && resource.data.role == 'staff'
        && isShopOwner(resource.data.shopId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive'])
        && request.resource.data.isActive is bool;

      allow delete: if false;
    }

    // shops/{shopId} and everything inside it
    match /shops/{shopId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid','name','createdAt']);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      allow delete: if false;

      // Materials: everybody in the shop reads, only the OWNER edits rates.
      match /materials/{materialId} {
        allow read: if isMember(shopId);

        allow create: if isShopOwner(shopId)
          && request.resource.data.keys().hasOnly(
               ['name','rate','rateKg','ratePakaSeer','ratePiece','priceUnit','isActive','createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.rate is number
          && request.resource.data.rate >= 0
          && request.resource.data.rateKg is number
          && request.resource.data.rateKg >= 0
          && request.resource.data.ratePakaSeer is number
          && request.resource.data.ratePakaSeer >= 0
          && (!('ratePiece' in request.resource.data)
              || (request.resource.data.ratePiece is number && request.resource.data.ratePiece >= 0))
          && request.resource.data.priceUnit in ['kg','pakaSeer','piece']
          && request.resource.data.isActive is bool;

        allow update: if isShopOwner(shopId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','rate','rateKg','ratePakaSeer','ratePiece','priceUnit','isActive'])
          && (!('priceUnit' in request.resource.data) || request.resource.data.priceUnit in ['kg','pakaSeer','piece']);

        allow delete: if false;
      }

      // Purchase slips: owner AND munshi can create. Only the OWNER can cancel (void).
      match /purchases/{purchaseId} {
        allow read: if isMember(shopId);

        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(
               ['items','totalAmount','totalWeightGrams','sellerName','dayKey',
                'createdAt','createdBy','isVoided'])
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 30
          && request.resource.data.totalAmount is int
          && request.resource.data.totalAmount >= 0
          && request.resource.data.totalWeightGrams is int
          && request.resource.data.totalWeightGrams > 0
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.isVoided == false;

        allow update: if isShopOwner(shopId)
          && resource.data.isVoided == false
          && request.resource.data.isVoided == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVoided','voidedAt']);

        allow delete: if false;
      }

      // Per-day totals (maintained with FieldValue.increment by the app).
      function validDaily() {
        return request.resource.data.totalAmount is int
          && request.resource.data.totalAmount >= 0
          && request.resource.data.totalWeightGrams is int
          && request.resource.data.totalWeightGrams >= 0
          && request.resource.data.entryCount is int
          && request.resource.data.entryCount >= 0;
      }
      match /daily/{dayKey} {
        allow read: if isMember(shopId);

        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['totalAmount','totalWeightGrams','entryCount'])
          && validDaily();

        allow update: if isMember(shopId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['totalAmount','totalWeightGrams','entryCount'])
          && validDaily();

        allow delete: if false;
      }

      // Per-material stock. weightGrams may go negative on purpose (see Stock screen warning).
      // NOTE: rules cannot tell an increment from an overwrite, so a munshi who writes
      // directly (not through the app) could set a wrong stock figure. See CHANGES_PHASE5.md.
      function validStock() {
        return request.resource.data.weightGrams is int
          && request.resource.data.materialName is string
          && request.resource.data.materialName.size() > 0
          && request.resource.data.materialName.size() <= 60;
      }
      match /stock/{materialId} {
        allow read: if isMember(shopId);

        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['materialName','weightGrams'])
          && validStock();

        allow update: if isMember(shopId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['materialName','weightGrams'])
          && validStock();

        allow delete: if false;
      }

      // Sales to a bigger dealer / factory: owner AND munshi create, only OWNER cancels.
      match /sales/{saleId} {
        allow read: if isMember(shopId);

        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(
               ['items','totalAmount','totalWeightGrams','buyerName','dayKey',
                'createdAt','createdBy','isVoided'])
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 30
          && request.resource.data.totalAmount is int
          && request.resource.data.totalAmount >= 0
          && request.resource.data.totalWeightGrams is int
          && request.resource.data.totalWeightGrams > 0
          && request.resource.data.buyerName is string
          && request.resource.data.buyerName.size() <= 60
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.isVoided == false;

        allow update: if isShopOwner(shopId)
          && resource.data.isVoided == false
          && request.resource.data.isVoided == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVoided','voidedAt']);

        allow delete: if false;
      }

      match /salesDaily/{dayKey} {
        allow read: if isMember(shopId);

        allow create: if isMember(shopId)
          && request.resource.data.keys().hasOnly(['totalAmount','totalWeightGrams','entryCount'])
          && validDaily();

        allow update: if isMember(shopId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['totalAmount','totalWeightGrams','entryCount'])
          && validDaily();

        allow delete: if false;
      }

      // Manual stock changes: OWNER only. Create-only (never edited or deleted).
      match /adjustments/{adjustmentId} {
        allow read: if isShopOwner(shopId);

        allow create: if isShopOwner(shopId)
          && request.resource.data.keys().hasOnly(
               ['materialId','materialName','deltaGrams','reason','note','dayKey',
                'createdAt','createdBy','costPerKg'])
          && request.resource.data.materialId is string
          && request.resource.data.materialName is string
          && request.resource.data.materialName.size() > 0
          && request.resource.data.materialName.size() <= 60
          && request.resource.data.deltaGrams is int
          && request.resource.data.deltaGrams != 0
          && request.resource.data.deltaGrams >= -100000000
          && request.resource.data.deltaGrams <= 100000000
          && request.resource.data.reason in ['correction','loss','other','garbage','openingStock']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 200
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdBy == request.auth.uid
          // openingStock: add-only, must supply a non-negative costPerKg
          && (request.resource.data.reason != 'openingStock'
              || (request.resource.data.deltaGrams > 0
                  && 'costPerKg' in request.resource.data
                  && request.resource.data.costPerKg is number
                  && request.resource.data.costPerKg >= 0))
          // costPerKg is only allowed for openingStock
          && (request.resource.data.reason == 'openingStock'
              || !('costPerKg' in request.resource.data));

        allow update, delete: if false;
      }

      // Shop running costs: OWNER only (Phase 4 block, now part of the main file).
      match /expenses/{expenseId} {
        allow read: if isShopOwner(shopId);

        allow create: if isShopOwner(shopId)
          && request.resource.data.keys().hasOnly(
               ['amount','category','note','dayKey','createdAt','createdBy','isVoided'])
          && request.resource.data.amount is int
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 100000000
          && request.resource.data.category in
               ['labour','rent','utilities','transport','food','other']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 200
          && request.resource.data.dayKey is string
          && request.resource.data.dayKey.size() == 10
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.isVoided == false;

        allow update: if isShopOwner(shopId)
          && resource.data.isVoided == false
          && request.resource.data.isVoided == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVoided','voidedAt']);

        allow delete: if false;
      }
    }
  }
}
