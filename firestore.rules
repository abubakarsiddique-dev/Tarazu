rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True when the signed-in user owns this shop. Costs one extra document read
    // per request (cached within a request), negligible at this scale.
    function isShopOwner(shopId) {
      return signedIn()
        && get(/databases/$(database)/documents/shops/$(shopId)).data.ownerUid == request.auth.uid;
    }

    // users/{uid}: one document per account
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
             ['uid','ownerName','shopName','phone','email','role','shopId','isActive','createdAt'])
        && request.resource.data.keys().hasAll(
             ['uid','ownerName','shopName','email','role','shopId','isActive','createdAt'])
        && request.resource.data.uid == uid
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20))
        && request.resource.data.role == 'owner'
        && request.resource.data.isActive == true
        && request.resource.data.shopId is string
        && getAfter(/databases/$(database)/documents/shops/$(request.resource.data.shopId)).data.ownerUid == uid;

      // ONE update rule. (There used to be two; Firestore ORs rules together, so
      // the stricter copy did nothing.) Because affectedKeys is limited to
      // ownerName and phone, role / isActive / shopId can never change here.
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerName','phone'])
        && (!('phone' in request.resource.data)
            || (request.resource.data.phone is string && request.resource.data.phone.size() <= 20));

      allow delete: if false;
    }

    // shops/{shopId} and everything inside it
    match /shops/{shopId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid','name','createdAt']);

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']);

      allow delete: if false;

      // Materials the shop buys (iron, plastic, ...)
      match /materials/{materialId} {
        allow read: if isShopOwner(shopId);

        allow create: if isShopOwner(shopId)
          && request.resource.data.keys().hasOnly(
               ['name','rate','rateKg','ratePakaSeer','priceUnit','isActive','createdAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.rate is number
          && request.resource.data.rate >= 0
          && request.resource.data.rateKg is number
          && request.resource.data.rateKg >= 0
          && request.resource.data.ratePakaSeer is number
          && request.resource.data.ratePakaSeer >= 0
          && request.resource.data.priceUnit in ['kg','pakaSeer']
          && request.resource.data.isActive is bool;

        allow update: if isShopOwner(shopId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','rate','rateKg','ratePakaSeer','priceUnit','isActive'])
          && (!('priceUnit' in request.resource.data) || request.resource.data.priceUnit in ['kg','pakaSeer']);

        allow delete: if false; // deactivate instead, history keeps its name
      }

      // Purchase slips (one customer, 1..30 items)
      match /purchases/{purchaseId} {
        allow read: if isShopOwner(shopId);

        allow create: if isShopOwner(shopId)
          && request.resource.data.keys().hasOnly(
               ['items','totalAmount','totalWeightGrams','sellerName','dayKey',
                'createdAt','createdBy','isVoided'])
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 30
          && request.resource.data.totalAmount is int
          && request.resource.data.totalAmount >= 0
          && request.resource.data.totalWeightGrams is int
          && request.resource.data.totalWeightGrams > 0
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.isVoided == false;

        // Only one transition is allowed: not voided -> voided. No edits, no un-void.
        allow update: if isShopOwner(shopId)
          && resource.data.isVoided == false
          && request.resource.data.isVoided == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVoided','voidedAt']);

        allow delete: if false;
      }

      // Per-day totals (maintained with FieldValue.increment by the app).
      // Rules see the value AFTER the increment, so these checks hold the result:
      // a day can never end up with a negative total or a negative entry count.
      function validDaily() {
        return request.resource.data.totalAmount is int
          && request.resource.data.totalAmount >= 0
          && request.resource.data.totalWeightGrams is int
          && request.resource.data.totalWeightGrams >= 0
          && request.resource.data.entryCount is int
          && request.resource.data.entryCount >= 0;
      }
      match /daily/{dayKey} {
        allow read: if isShopOwner(shopId);

        allow create: if isShopOwner(shopId)
          && request.resource.data.keys().hasOnly(['totalAmount','totalWeightGrams','entryCount'])
          && validDaily();

        allow update: if isShopOwner(shopId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['totalAmount','totalWeightGrams','entryCount'])
          && validDaily();

        allow delete: if false;
      }

      // Per-material stock (maintained with FieldValue.increment by the app).
      // weightGrams may go negative on purpose: that means the books are wrong
      // (e.g. a purchase was cancelled after its stock was already sold) and it
      // should stay visible (the Stock screen shows a warning) instead of the
      // whole cancel being rejected. The app itself never lets a sale or a
      // manual removal take stock below zero.
      function validStock() {
        return request.resource.data.weightGrams is int
          && request.resource.data.materialName is string
          && request.resource.data.materialName.size() > 0
          && request.resource.data.materialName.size() <= 60;
      }
      match /stock/{materialId} {
        allow read: if isShopOwner(shopId);

        allow create: if isShopOwner(shopId)
          && request.resource.data.keys().hasOnly(['materialName','weightGrams'])
          && validStock();

        allow update: if isShopOwner(shopId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['materialName','weightGrams'])
          && validStock();

        allow delete: if false;
      }

      // Sales to a bigger dealer / factory (1..30 items)
      match /sales/{saleId} {
        allow read: if isShopOwner(shopId);

        allow create: if isShopOwner(shopId)
          && request.resource.data.keys().hasOnly(
               ['items','totalAmount','totalWeightGrams','buyerName','dayKey',
                'createdAt','createdBy','isVoided'])
          && request.resource.data.items is list
          && request.resource.data.items.size() >= 1
          && request.resource.data.items.size() <= 30
          && request.resource.data.totalAmount is int
          && request.resource.data.totalAmount >= 0
          && request.resource.data.totalWeightGrams is int
          && request.resource.data.totalWeightGrams > 0
          && request.resource.data.buyerName is string
          && request.resource.data.buyerName.size() <= 60
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.isVoided == false;

        // Same single transition as purchases: not voided -> voided.
        allow update: if isShopOwner(shopId)
          && resource.data.isVoided == false
          && request.resource.data.isVoided == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isVoided','voidedAt']);

        allow delete: if false;
      }

      // Per-day SALES totals (same shape and checks as `daily`).
      match /salesDaily/{dayKey} {
        allow read: if isShopOwner(shopId);

        allow create: if isShopOwner(shopId)
          && request.resource.data.keys().hasOnly(['totalAmount','totalWeightGrams','entryCount'])
          && validDaily();

        allow update: if isShopOwner(shopId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['totalAmount','totalWeightGrams','entryCount'])
          && validDaily();

        allow delete: if false;
      }

      // Manual stock changes. Create-only: a record can never be edited or
      // deleted. To undo one, make another adjustment.
      match /adjustments/{adjustmentId} {
        allow read: if isShopOwner(shopId);

        allow create: if isShopOwner(shopId)
          && request.resource.data.keys().hasOnly(
               ['materialId','materialName','deltaGrams','reason','note','dayKey',
                'createdAt','createdBy'])
          && request.resource.data.materialId is string
          && request.resource.data.materialName is string
          && request.resource.data.materialName.size() > 0
          && request.resource.data.materialName.size() <= 60
          && request.resource.data.deltaGrams is int
          && request.resource.data.deltaGrams != 0
          && request.resource.data.deltaGrams >= -100000000
          && request.resource.data.deltaGrams <= 100000000
          && request.resource.data.reason in ['correction','loss','other']
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 200
          && request.resource.data.createdAt is timestamp
          && request.resource.data.createdBy == request.auth.uid;

        allow update, delete: if false;
      }
    }
  }
}
